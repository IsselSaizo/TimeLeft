# Auto detect text files and perform LF normalization
* text=auto

*.rs   text eol=lf
*.toml text eol=lf
*.kt   text eol=lf
*.kts  text eol=lf
*.swift text eol=lf
*.md   text eol=lf
*.json text eol=lf
Cargo.lock text eol=lf

gradlew      text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf

*.bin  binary
*.jar  binary
*.png  binary
